{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  },
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000"
    }
   ]
  }
 ]
}